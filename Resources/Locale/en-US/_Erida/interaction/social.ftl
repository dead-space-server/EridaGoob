social-gesture-handshake-complete-others = { CAPITALIZE(THE($user)) } shakes hands with { THE($target) }.
social-gesture-handshake-expire-self = Nobody shook your hand.
social-gesture-handshake-expire-others = { CAPITALIZE(THE($user)) } awkwardly lowers the offered hand.
social-gesture-highfive-offer-self = You raise your palm for { THE($target) }.
