interaction-Handshake-name = Shake hands
interaction-Handshake-description = Offer your hand. If they already offered theirs, shake it.
interaction-HighFive-name = High five
interaction-HighFive-description = Raise your palm. If they already raised theirs, slap it.
interaction-FistBump-name = Fist bump
interaction-FistBump-description = Offer your fist. If they already offered theirs, bump it.
interaction-TailPull-name = Pull tail
interaction-TailPull-description = Give their tail a tug.
interaction-TailPull-success-self-popup = You pull { THE($target) }'s tail.
interaction-TailPull-success-target-popup = { CAPITALIZE(THE($user)) } pulls your tail!
interaction-TailPull-success-others-popup = { CAPITALIZE(THE($user)) } pulls { THE($target) }'s tail.
interaction-BlowKiss-name = Blow a kiss
interaction-BlowKiss-description = The kiss flies to whoever is first in its way.
interaction-BlowKiss-success-self-popup = You blow a kiss to { THE($target) }.
interaction-BlowKiss-success-target-popup = { CAPITALIZE(THE($user)) } blows you a kiss.
interaction-BlowKiss-success-others-popup = { CAPITALIZE(THE($user)) } blows a kiss to { THE($target) }.
interaction-LightCigarette-name = Give a light
interaction-LightCigarette-description = Light the cigarette in their mouth with what you hold.
interaction-LightCigarette-success-self-popup = You give { THE($target) } a light.
interaction-LightCigarette-success-target-popup = { CAPITALIZE(THE($user)) } gives you a light.
interaction-LightCigarette-success-others-popup = { CAPITALIZE(THE($user)) } gives { THE($target) } a light.
social-kiss-hit = A kiss from { THE($user) } lands on you!
