<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:customControls="clr-namespace:Content.Client.Administration.UI.CustomControls"
                      xmlns:erida="clr-namespace:Content.Client._Erida.Research.UI"
                      Title="{Loc 'research-console-menu-title'}"
                      SetSize="1260 800"
                      MinSize="960 640">
    <BoxContainer Orientation="Vertical"
                  HorizontalExpand="True"
                  VerticalExpand="True">
        <PanelContainer HorizontalExpand="True">
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BackgroundColor="#181A20" />
            </PanelContainer.PanelOverride>
            <BoxContainer Orientation="Horizontal"
                          HorizontalExpand="True"
                          Margin="10 8"
                          SeparationOverride="10"
                          VerticalAlignment="Center">
                <PanelContainer>
                    <PanelContainer.PanelOverride>
                        <gfx:StyleBoxFlat BorderThickness="3 0 0 0" BorderColor="#9A6EF0" />
                    </PanelContainer.PanelOverride>
                    <PanelContainer Margin="2 0 0 0">
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat BackgroundColor="#1F2129"
                                              BorderColor="#2E313C"
                                              BorderThickness="1" />
                        </PanelContainer.PanelOverride>
                        <BoxContainer Orientation="Vertical" Margin="10 4" MinWidth="130">
                            <Label Text="{Loc 'erida-research-console-points-label'}"
                                   StyleClasses="LabelSubText" />
                            <Label Name="ResearchAmountLabel"
                                   StyleClasses="LabelKeyText" />
                        </BoxContainer>
                    </PanelContainer>
                </PanelContainer>

                <BoxContainer Name="TierDisplayContainer"
                              Orientation="Horizontal"
                              HorizontalExpand="True"
                              SeparationOverride="6"
                              VerticalAlignment="Center" />

                <LineEdit Name="SearchBar"
                          PlaceHolder="{Loc 'erida-research-console-search-placeholder'}"
                          MinWidth="195"
                          MaxWidth="220"
                          MinHeight="34"
                          VerticalAlignment="Center" />

                <Button Name="ServerButton"
                        Text="{Loc 'research-console-menu-server-selection-button'}"
                        StyleClasses="ButtonSquare"
                        MinHeight="36"
                        VerticalAlignment="Center" />
            </BoxContainer>
        </PanelContainer>

        <customControls:HSeparator StyleClasses="LowDivider" />

        <BoxContainer Orientation="Horizontal"
                      HorizontalExpand="True"
                      VerticalExpand="True">
            <PanelContainer HorizontalExpand="True"
                            VerticalExpand="True"
                            SizeFlagsStretchRatio="3">
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat BackgroundColor="#14161B" />
                </PanelContainer.PanelOverride>
                <erida:EridaResearchesContainerPanel Name="DragContainer"
                                                     HorizontalExpand="True"
                                                     VerticalExpand="True"
                                                     MouseFilter="Pass"
                                                     RectClipContent="True" />
                <Button Name="RecenterButton"
                        Text="{Loc 'research-console-menu-recenter-button'}"
                        StyleClasses="ButtonSquare"
                        MinHeight="30"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="10" />
            </PanelContainer>

            <PanelContainer MinWidth="400"
                            MaxWidth="440"
                            VerticalExpand="True">
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat BackgroundColor="#181A20"
                                      BorderColor="#2A2D36"
                                      BorderThickness="1 0 0 0" />
                </PanelContainer.PanelOverride>
                <BoxContainer Name="InfoContainer"
                              Orientation="Vertical"
                              VerticalExpand="True"
                              HorizontalExpand="True" />
            </PanelContainer>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
