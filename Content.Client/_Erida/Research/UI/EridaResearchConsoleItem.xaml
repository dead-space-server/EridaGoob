<LayoutContainer xmlns="https://spacestation14.io"
                 xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                 xmlns:erida="clr-namespace:Content.Client._Erida.Research.UI"
                 HorizontalExpand="False">
    <BoxContainer Name="CardBox"
                  Orientation="Vertical"
                  MinWidth="228"
                  MaxWidth="228"
                  MinHeight="48">
        <PanelContainer Name="AccentPanel"
                        VerticalExpand="True"
                        HorizontalExpand="True">
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BorderThickness="3 0 0 0" />
            </PanelContainer.PanelOverride>
            <PanelContainer Name="CardPanel"
                            VerticalExpand="True"
                            HorizontalExpand="True"
                            Margin="2 0 0 0"
                            RectClipContent="True">
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat BackgroundColor="#1B1C21"
                                      BorderColor="#2B2D36"
                                      BorderThickness="1" />
                </PanelContainer.PanelOverride>
                <erida:EridaDrawButton Name="Button"
                                       Access="Public"
                                       ModulateSelfOverride="#00000000"
                                       HorizontalExpand="True"
                                       VerticalExpand="True" />
                <BoxContainer Orientation="Horizontal"
                              Margin="7 5"
                              SeparationOverride="7"
                              VerticalAlignment="Center"
                              MouseFilter="Ignore">
                    <TextureRect Name="ResearchDisplay"
                                 SetSize="28 28"
                                 Stretch="KeepAspectCentered"
                                 VerticalAlignment="Center"
                                 MouseFilter="Ignore" />
                    <BoxContainer Name="TextContainer"
                                  Orientation="Vertical"
                                  HorizontalExpand="True"
                                  VerticalAlignment="Center"
                                  SeparationOverride="2"
                                  MouseFilter="Ignore">
                        <RichTextLabel Name="TechNameLabel"
                                       HorizontalExpand="True"
                                       MouseFilter="Ignore" />
                        <BoxContainer Name="MetaContainer"
                                      Orientation="Horizontal"
                                      SeparationOverride="5"
                                      MouseFilter="Ignore">
                            <Label Name="CostLabel"
                                   MouseFilter="Ignore" />
                            <Label Name="TierLabel"
                                   MouseFilter="Ignore" />
                        </BoxContainer>
                    </BoxContainer>
                </BoxContainer>
            </PanelContainer>
        </PanelContainer>
    </BoxContainer>
</LayoutContainer>
